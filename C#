using System;

class Program
{
    static void Main()
    {
        string[] files =
        {
            "image1.png",
            "image2.png",
            "image3.png"
        };

        for (int i = 0; i < files.Length; i++)
        {
            string newName =
                $"renamed_{i + 1}.png";

            Console.WriteLine(
                $"{files[i]} -> {newName}"
            );
        }
    }
}
